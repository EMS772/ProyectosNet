@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Error al Restablecer Contraseña</title>
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <div class="login-header">
                <h1>Error</h1>
                <p>El enlace para restablecer la contraseña es inválido o ha expirado.</p>
            </div>
            <p class="login-link">
                <a href="@Url.Action("Login", "Auth")">Volver al inicio de sesión</a>
            </p>
        </div>
    </div>
</body>
</html>