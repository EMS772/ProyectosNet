@model MoneyMindIA.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoneyMind - Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="login-container">
        <div class="login-box">
            <!-- Logo y Título -->
            <div class="login-header">
                <img src="https://firebasestorage.googleapis.com/v0/b/twecommerce-14b8f.appspot.com/o/MoneyMind%2FLogoMMB.png?alt=media&token=00a7e6ed-6c8b-4481-9c30-dc228f2a771b"
                     alt="MoneyMind Logo" class="log">
                <h1>Bienvenido de vuelta</h1>
                <p class="subtitle">Ingresa tus datos para continuar</p>
            </div>

            <!-- Mensajes de error -->
            <div asp-validation-summary="All" class="text-danger"></div>

            <!-- Mensaje específico para email no confirmado -->
            @if (TempData["EmailNotConfirmed"] != null)
            {
                <div class="alert alert-warning">
                    @TempData["EmailNotConfirmed"]
                    <a href="#" class="resend-link" onclick="resendConfirmationEmail('@Model.Email')">Reenviar correo</a>
                </div>
            }

            <!-- Formulario de Inicio de Sesión -->
            <form asp-action="Login" method="post" class="login-form">
                <div class="input-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" placeholder="Ingresa tu correo electrónico" required>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Ingresa tu contraseña" required>
                    <span asp-validation-for="Password" class="text-danger"></span>
                    <a href="@Url.Action("ForgotPassword", "Auth")" class="forgot-password">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="login-button">
                    <i class="fas fa-sign-in-alt"></i>
                    Iniciar Sesión
                </button>
            </form>

            <!-- Separador -->
            <div class="separator">
                <span>o</span>
            </div>

            <!-- Botón de Google -->
            <a asp-action="LoginWithGoogle" asp-controller="Auth" class="google-login">
                <img class="google-logo" src="https://firebasestorage.googleapis.com/v0/b/twecommerce-14b8f.appspot.com/o/MoneyMind%2FGoogle__G__logo.svg.png?alt=media&token=3b119224-57b5-4499-a731-0caea15bbefe">
                Iniciar/Registrar con Google
            </a>

            <!-- Enlace de Registro -->
            <p class="register-link">
                ¿No tienes una cuenta? <a href="@Url.Action("Registro", "Auth")">Regístrate aquí</a>
            </p>
        </div>
    </div>

    <!-- Scripts de validación y reenvío -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>

    <!-- Agregar esto dentro del formulario de login -->
    @if (TempData["EmailNotConfirmed"] != null)
    {
        <div class="alert alert-warning">
            @TempData["EmailNotConfirmed"]
            <a href="#" class="resend-link" onclick="resendConfirmationEmail('@Model.Email')">Reenviar correo</a>
        </div>
    }

    <!-- Agregar este script al final del archivo -->
    <script>
              function resendConfirmationEmail(email) {
            if (!email) {
                alert('Por favor, ingrese su correo electrónico');
                return;
            }

            fetch('/Auth/ResendConfirmationEmail?email=' + encodeURIComponent(email), {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
            .then(async response => {
                const text = await response.text();
                if (response.ok) {
                    alert('¡Correo de confirmación reenviado! Por favor, revisa tu bandeja de entrada.');
                } else {
                    alert('Error: ' + text);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Error al reenviar el correo. Por favor, intenta nuevamente.');
            });
        }
    </script>
</body>
</html>