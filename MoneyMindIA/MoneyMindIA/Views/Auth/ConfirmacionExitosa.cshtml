@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Correo Confirmado</title>
    <style>
        /* Estilos generales */
        body {
            margin: 0;
            padding: 0;
            font-family: 'Arial', sans-serif;
            background: linear-gradient(135deg, #359d7a, #2a7d5f);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            color: #ffffff;
            text-align: center;
        }

        /* Contenedor principal */
        .confirmation-container {
            background: rgba(255, 255, 255, 0.1);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
            max-width: 400px;
            width: 100%;
        }

        /* Título */
        h1 {
            font-size: 2rem;
            margin-bottom: 20px;
            font-weight: bold;
        }

        /* Enlace de inicio de sesión */
        a {
            display: inline-block;
            background: #ffffff;
            color: #2a7d5f;
            padding: 12px 24px;
            border-radius: 25px;
            text-decoration: none;
            font-size: 1rem;
            font-weight: bold;
            transition: background 0.3s ease, color 0.3s ease;
        }

        a:hover {
            background: #f1c40f;
            color: #ffffff;
        }
        .confirmation-container {
            animation: fadeIn 0.8s ease-out;
        }
    </style>
</head>
<body>
    <h1>¡Correo confirmado exitosamente!</h1>
    <a href="@Url.Action("Login", "Auth")">Iniciar Sesión</a>
</body>
</html>